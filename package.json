{
  "name": "strix-tabletop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 4174 --strictPort",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build --config vite.config.ts",
    "electron:dist": "node scripts/build-electron.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0 --port 4174 --strictPort"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^1.35.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.thecalled.strixtabletop",
    "productName": "The Called",
    "directories": {
      "output": "release/package"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
