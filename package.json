{
  "name": "the-called",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsx scripts/sprites-lint.ts && vite build",
    "lint": "tsc -p tsconfig.app.json --noEmit",
    "sprites:lint": "tsx scripts/sprites-lint.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx src/tools/sim.ts",
    "sim:compare": "tsx src/tools/sim.ts --compare",
    "electron": "electron .",
    "pack": "npm run build && node scripts/pack-electron.mjs"
  },
  "build": {
    "appId": "local.thecalled.prototype",
    "productName": "The Called",
    "directories": {
      "output": "packaged"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "The-Called-${version}-win.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
