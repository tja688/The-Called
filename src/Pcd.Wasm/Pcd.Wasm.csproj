<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>main.mjs</WasmMainJSPath>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pcd.Kernel\Pcd.Kernel.csproj" />
    <ProjectReference Include="..\Pcd.PlayHost\Pcd.PlayHost.csproj" />
    <WasmExtraFilesToDeploy Include="main.mjs" />
  </ItemGroup>
</Project>
